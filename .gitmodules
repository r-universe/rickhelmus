[submodule ".registry"]
	path = .registry
	url = https://github.com/rickhelmus/rickhelmus.r-universe.dev
	branch = HEAD
[submodule "KPIC"]
	path = KPIC
	url = https://github.com/rickhelmus/KPIC2
[submodule "MS2Quant"]
	path = MS2Quant
	url = https://github.com/kruvelab/MS2Quant
	branch = main
[submodule "MS2Tox"]
	path = MS2Tox
	url = https://github.com/rickhelmus/MS2Tox
	branch = model_fix
[submodule "MetaClean"]
	path = MetaClean
	url = https://github.com/KelseyChetnik/MetaClean
[submodule "RAMClustR"]
	path = RAMClustR
	url = https://github.com/cbroeckl/RAMClustR
[submodule "RDCOMClient"]
	path = RDCOMClient
	url = https://github.com/rickhelmus/RDCOMClient
[submodule "RSirius"]
	path = RSirius
	url = https://github.com/sirius-ms/sirius-client-openAPI
	subdir = client-api_r/generated
[submodule "Rmstoolkitlib"]
	path = Rmstoolkitlib
	url = https://github.com/rickhelmus/Rmstoolkitlib
	branch = main
[submodule "cliqueMS"]
	path = cliqueMS
	url = https://github.com/rickhelmus/cliqueMS
[submodule "enviPick"]
	path = enviPick
	url = https://github.com/blosloos/enviPick
[submodule "fastAdaboost"]
	path = fastAdaboost
	url = https://github.com/souravc83/fastAdaboost
[submodule "nontarget"]
	path = nontarget
	url = https://github.com/blosloos/nontarget
[submodule "nontargetData"]
	path = nontargetData
	url = https://github.com/blosloos/nontargetData
[submodule "patRoon"]
	path = patRoon
	url = https://github.com/rickhelmus/patRoon
[submodule "patRoonInst"]
	path = patRoonInst
	url = https://github.com/rickhelmus/patRoonInst
[submodule "qlcMatrix"]
	path = qlcMatrix
	url = https://github.com/cysouw/qlcMatrix
[submodule "splashR"]
	path = splashR
	url = https://github.com/berlinguyinca/spectra-hash
